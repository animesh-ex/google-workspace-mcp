    "docs": "node scripts/gen-tools-doc.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@googleapis/analyticsadmin": "^22.0.2",
    "@googleapis/analyticsdata": "^10.1.1",
    "@googleapis/calendar": "^20.2.0",
    "@googleapis/chat": "^51.4.1",
    "@googleapis/dialogflow": "^35.2.0",
    "@googleapis/docs": "^14.1.1",
    "@googleapis/drive": "^27.1.0",
    "@googleapis/gmail": "^22.1.0",
    "@googleapis/merchantapi": "^25.3.1",
    "@googleapis/people": "^12.0.1",
    "@googleapis/script": "^16.0.1",
    "@googleapis/searchconsole": "^11.0.1",
    "@googleapis/sheets": "^18.1.3",
    "@googleapis/slides": "^10.1.1",
    "@googleapis/tagmanager": "^20.0.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "google-auth-library": "^11.3.4",
    "open": "^11.0.4",
    "zod": "^4.6.7"

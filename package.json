{
  "name": "google-workspace-mcp",
  "version": "1.8.0",
  "description": "MCP connector for Gmail, Google Drive, Docs, Sheets and Slides",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "google-workspace-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "auth": "node dist/auth-cli.js",
    "start": "node dist/index.js",
